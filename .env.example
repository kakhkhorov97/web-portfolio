# Gemini key for the "Ask about me" chat. Without it the chat points visitors to email.
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
CHAT_DAILY_CAP=200
# Your live URL, used for link previews (Open Graph image), e.g. https://sean-kakhkhorov.vercel.app
NEXT_PUBLIC_SITE_URL=
